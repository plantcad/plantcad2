# get fname based on the SLURM_ARRAY_TASK_ID
fname=${fnames[$SLURM_ARRAY_TASK_ID]}

# the output is the replace .tsv with _pcv1_logits.tsv
OUTPUT_DIR=valid_pcv2_l24_d0768_logits.tsv

python main.py \
    -input 'valid' \
    -outLogit ${OUTPUT_DIR} \
    -model 'kuleshov-group/compo-cad2-l24-dna-chtk-c8192-v2-b2-NpnkD-ba240000' \
    -device 'cuda:0'