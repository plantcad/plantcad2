srun -l python plantcad2.py fetch \
	--input ${INPUT_DIR}test_zea_mays.tsv \
	--output ${OUTPUT_NAME} \
	--batch-size 64 \
    --model-dir 'kuleshov-group/PlantCAD2-Large-l48-d1536'
