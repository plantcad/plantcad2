#!/bin/bash

#SBATCH -J pcv2-large
#SBATCH -o logs/%x-%j.log
#SBATCH -e logs/%x-%j.log
#SBATCH -p gh
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH -t 12:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=jz963@cornell.edu
#SBATCH -a 0-3

module load gcc/13.2.0 cuda/12.5
module load python3/3.11.8

source $WORK/envs/transformers_440/bin/activate
source ~/.bashrc

# Environment variables
export TRITON_PTXAS_PATH=/home1/apps/nvidia/Linux_aarch64/24.7/cuda/12.5/bin/ptxas

fnames=(
    "train.tsv"
	"test_setaria_viridis.tsv"
	"test_eutrema_salsugineum.tsv"
	"test_populus_trichocarpa.tsv"
)

INPUT_DIR="/scratch/10373/jzhai/fine-tuning/cross_species_acr_train_on_arabidopsis/"
OUTPUT_DIR="/scratch/10373/jzhai/utils/plantcad2/results/review/1_benchmark_evo2/plantcad2/"
fname=${fnames[$SLURM_ARRAY_TASK_ID]}
OUTPUT_NAME=${OUTPUT_DIR}${fname%.tsv}_large.pkl

python plantcad2.py fetch \
	--input ${INPUT_DIR}${fname} \
	--output ${OUTPUT_NAME} \
	--batch-size 64 \
    --model-dir 'kuleshov-group/PlantCAD2-Large-l48-d1536'